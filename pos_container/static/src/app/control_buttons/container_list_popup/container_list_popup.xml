<?xml version="1.0" encoding="UTF-8"?>
<templates id="template" xml:space="preserve">
    <t t-name="pos_container.ContainerListPopup">
        <Dialog contentClass="'h-100'" bodyClass="'p-0 d-flex flex-column'" size="'xl'">
            <div class="container-list-popup d-flex flex-column h-100">
                <!-- Header: Annuler | Recherche -->
                <div class="d-flex align-items-center justify-content-start p-3 border-bottom bg-light gap-3">
                    <!-- Gauche: Annuler -->
                    <button class="btn btn-secondary btn-lg" t-on-click="cancel">
                        « Annuler
                    </button>

                    <!-- Centre: Recherche -->
                    <div class="input-group flex-grow-1 mx-auto" style="max-width: 500px;">
                        <span class="input-group-text bg-white">
                            <i class="fa fa-search text-muted"/>
                        </span>
                        <input
                            type="text"
                            class="form-control"
                            placeholder="Recherche contenant"
                            t-att-value="state.searchTerm"
                            t-on-input="onSearchInput"
                            autofocus="true"
                        />
                    </div>

                </div>

                <!-- Container table -->
                <div class="flex-grow-1 overflow-auto">
                    <table class="table table-hover mb-0">
                        <thead class="sticky-top bg-white">
                            <tr>
                                <th class="py-3">Nom</th>
                                <th class="py-3">Code Barre</th>
                                <th class="py-3">Poids</th>
                                <th class="py-3">Valeur consigne</th>
                                <th class="py-3">Statut</th>
                            </tr>
                        </thead>
                        <tbody>
                            <t t-if="filteredContainers.length === 0">
                                <tr>
                                    <td colspan="5" class="text-center text-muted p-5">
                                        <i class="fa fa-inbox fa-3x mb-3 d-block"/>
                                        <span>Aucun contenant trouvé</span>
                                    </td>
                                </tr>
                            </t>
                            <t t-foreach="filteredContainers" t-as="container" t-key="container.id">
                                <tr class="cursor-pointer" t-on-click="() => this.selectContainer(container)">
                                    <td class="py-3" t-esc="container.name"/>
                                    <td class="py-3 font-monospace" t-esc="container.barcode"/>
                                    <td class="py-3" t-esc="formatWeight(container.tare)"/>
                                    <td class="py-3"><t t-esc="formatDeposit(container.deposit_amount)"/> €</td>
                                    <td class="py-3" t-esc="container.state === 'in_store' ? 'Magasin' : 'Client'"/>
                                </tr>
                            </t>
                        </tbody>
                    </table>
                </div>
            </div>
        </Dialog>
    </t>
</templates>
