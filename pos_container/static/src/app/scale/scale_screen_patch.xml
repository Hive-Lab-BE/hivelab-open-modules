<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">

    <!-- Extension du ScaleScreen - Layout unifié avec numpad toujours disponible -->
    <t t-name="pos_container.ScaleScreenUnified" t-inherit="point_of_sale.ScaleScreen" t-inherit-mode="extension">

        <!-- Ajouter le bandeau déconnexion avant le contenu principal -->
        <xpath expr="//div[hasclass('gross-weight')]/ancestor::div[hasclass('flex-column')]" position="before">
            <div t-if="scale.isDisconnected" class="alert alert-warning mb-3 d-flex align-items-center justify-content-center gap-2 py-2">
                <i class="fa fa-exclamation-triangle"/>
                <span class="fs-5">Balance déconnectée - Saisie manuelle</span>
            </div>
        </xpath>

        <!-- Ajouter classe pour le layout avec numpad -->
        <xpath expr="//div[hasclass('gross-weight')]/ancestor::div[hasclass('flex-column')]" position="attributes">
            <attribute name="t-att-class">manualState.activeNumpadField ? 'scale-form-with-numpad' : ''</attribute>
        </xpath>

        <!-- Remplacer l'affichage du poids brut par version unifiée -->
        <xpath expr="//div[hasclass('gross-weight')]/.." position="replace">
            <div class="d-flex gap-2 align-items-center mb-2">
                <div class="w-60 fs-3 me-2">Poids Brut:</div>
                <!-- Mode auto: affichage texte -->
                <div t-if="!scale.isWeightOverridden" class="gross-weight fs-3 px-5 text-end form-control-plaintext" t-esc="scale.grossWeightString"/>
                <!-- Mode override: input -->
                <t t-if="scale.isWeightOverridden">
                    <div class="d-flex align-items-center flex-grow-1">
                        <input type="number"
                               step="0.001"
                               min="0"
                               class="form-control form-control-lg text-end fs-3"
                               t-att-value="manualState.manualWeightInput"
                               t-on-input="onManualWeightChange"
                               placeholder="0.000"/>
                        <span class="ms-2 fs-3" t-esc="scale._safeUnitOfMeasure"/>
                    </div>
                </t>
                <!-- Bouton calculatrice toujours visible -->
                <button class="btn btn-lg ms-2"
                        t-att-class="manualState.activeNumpadField === 'weight' ? 'btn-primary' : 'btn-outline-secondary'"
                        t-on-click="() => this.toggleNumpad('weight')"
                        title="Numpad poids">
                    <i class="fa fa-calculator"/>
                </button>
            </div>
        </xpath>

        <!-- Remplacer la section tare par version unifiée -->
        <xpath expr="//button[@t-on-click='() =&gt; scale.requestTare()']/../.." position="replace">
            <div class="d-flex gap-2 align-items-center mb-2">
                <!-- Bouton Tare (désactivé si déconnecté) -->
                <button class="btn btn-primary fs-3"
                        t-att-disabled="scale.tareRequested or scale.isDisconnected"
                        t-on-click="() => scale.requestTare()">
                    <i t-if="scale.tareRequested" class="fa fa-circle-o-notch fa-spin"/>
                    <t t-else="">Tare</t>
                </button>
                <!-- Indicateur Auto/Manuel (si tare > 0) -->
                <span t-if="scale.tare > 0 and !scale.isTareManual" class="fs-4 fst-italic text-muted">Automatique</span>
                <span t-if="scale.tare > 0 and scale.isTareManual" class="fs-4 fst-italic text-warning">Manuel</span>
                <!-- Séparateur -->
                <span class="fs-3 ms-auto">-</span>
                <!-- Input tare -->
                <div class="d-flex flex-row align-items-center">
                    <t t-if="manualState.activeNumpadField === 'tare'">
                        <input type="number"
                               step="0.001"
                               min="0"
                               class="form-control me-2"
                               style="width: 100px;"
                               t-att-value="manualState.tareInput"
                               t-on-input="onTareInputChange"
                               placeholder="0.000"/>
                    </t>
                    <t t-else="">
                        <input type="number"
                               class="form-control me-2"
                               t-att-readonly="scale.tareRequested"
                               t-model.number="this.scale.tare"
                               t-on-input="onTareInputChange"/>
                    </t>
                    <span class="text-end fs-3" t-esc="scale._safeUnitOfMeasure"/>
                </div>
                <!-- Bouton calculatrice tare toujours visible -->
                <button class="btn btn-lg ms-2"
                        t-att-class="manualState.activeNumpadField === 'tare' ? 'btn-primary' : 'btn-outline-secondary'"
                        t-on-click="() => this.toggleNumpad('tare')"
                        title="Numpad tare">
                    <i class="fa fa-calculator"/>
                </button>
            </div>
        </xpath>

        <!-- Remplacer le poids net par version unifiée -->
        <xpath expr="//div[@t-esc='scale.netWeightString']/.." position="replace">
            <div class="d-flex gap-2 align-items-center mb-2 p-2 bg-light rounded">
                <div class="w-60 fs-3 me-2 fw-bold">Poids Net:</div>
                <div class="text-end fs-2 px-5 fw-bold text-primary" t-esc="scale.effectiveNetWeightString"/>
            </div>
        </xpath>

        <!-- Ajouter le numpad à côté via CSS positioning -->
        <xpath expr="//div[hasclass('product-price')]/.." position="after">
            <div t-if="manualState.activeNumpadField"
                 class="scale-numpad-container d-flex flex-column align-items-center justify-content-center">
                <div class="text-muted mb-2 fs-5">
                    Saisie: <t t-if="manualState.activeNumpadField === 'weight'">Poids Brut</t><t t-else="">Tare</t>
                </div>
                <Numpad buttons="getSimpleNumpadButtons()" onClick.bind="onNumpadClick" class="'numpad-scale'"/>
            </div>
        </xpath>

        <!-- Masquer le bouton "Get Weight" quand poids override -->
        <xpath expr="//button[@t-on-click='() =&gt; scale.readWeight()']" position="attributes">
            <attribute name="t-if">scale.isManualMeasurement and !scale.isWeightOverridden</attribute>
        </xpath>

        <!-- Mettre à jour le bouton Order avec isOrderValid -->
        <xpath expr="//button[hasclass('buy-product')]" position="attributes">
            <attribute name="t-att-disabled">!isOrderValid</attribute>
        </xpath>

    </t>

</templates>
