<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="pos_config_view_form_container" model="ir.ui.view">
        <field name="name">pos.config.form.container</field>
        <field name="model">pos.config</field>
        <field name="inherit_id" ref="point_of_sale.pos_config_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//setting[@id='other_devices']" position="after">
                <div class="col-12 col-lg-6 o_setting_box" id="container_deposit">
                    <div class="o_setting_left_pane"/>
                    <div class="o_setting_right_pane">
                        <label for="deposit_product_id"/>
                        <div class="text-muted">
                            Produit utilisé pour facturer la consigne des contenants réutilisables
                        </div>
                        <div class="content-group">
                            <field name="deposit_product_id"/>
                        </div>
                    </div>
                </div>
            </xpath>
        </field>
    </record>

</odoo>
