<?xml version="1.0" encoding="UTF-8"?>
<templates id="template" xml:space="preserve">

    <t t-name="pos_hash_cert.HashCertPopup">
        <Dialog title="title" size="'xl'">
            <div class="hash-cert-popup">
                <!-- Loading state -->
                <div t-if="state.loading" class="text-center py-5">
                    <i class="fa fa-spinner fa-spin fa-3x text-primary"/>
                    <p class="mt-3 text-muted">Chargement des certifications...</p>
                </div>

                <!-- Error state -->
                <div t-elif="state.error" class="alert alert-danger m-3">
                    <i class="fa fa-exclamation-triangle me-2"/>
                    <t t-esc="state.error"/>
                </div>

                <!-- Content -->
                <div t-else="" class="p-2">
                    <!-- Header with overall status and info -->
                    <div class="row mb-2">
                        <!-- Left: Overall Status -->
                        <div class="col-md-4">
                            <div class="card h-100">
                                <div class="card-body text-center py-2">
                                    <i t-attf-class="fa fa-3x {{ overallStatusIcon }} {{ overallStatusClass }} mb-1"/>
                                    <h5 t-attf-class="{{ overallStatusClass }} mb-0" t-esc="overallStatusText"/>
                                    <small class="text-muted">Conformité LNE</small>
                                </div>
                            </div>
                        </div>

                        <!-- Right: System Info -->
                        <div class="col-md-8">
                            <div class="card h-100">
                                <div class="card-header bg-primary text-white py-2">
                                    <i class="fa fa-info-circle me-2"/>
                                    Informations Système
                                </div>
                                <div class="card-body py-2">
                                    <div class="row small">
                                        <div class="col-6">
                                            <table class="table table-sm table-borderless mb-0">
                                                <tr>
                                                    <td class="text-muted">Vendeur:</td>
                                                    <td><strong t-esc="state.vendor"/></td>
                                                </tr>
                                                <tr>
                                                    <td class="text-muted">Point de Vente:</td>
                                                    <td><strong t-esc="state.posName"/></td>
                                                </tr>
                                                <tr>
                                                    <td class="text-muted">N° Certificat:</td>
                                                    <td><strong t-esc="state.certificateNumber"/></td>
                                                </tr>
                                            </table>
                                        </div>
                                        <div class="col-6">
                                            <table class="table table-sm table-borderless mb-0">
                                                <tr>
                                                    <td class="text-muted">Version Odoo:</td>
                                                    <td><strong t-esc="state.odooVersion"/></td>
                                                </tr>
                                                <tr>
                                                    <td class="text-muted">Version POS:</td>
                                                    <td><strong t-esc="state.posAppVersion or 'N/A'"/></td>
                                                </tr>
                                                <tr>
                                                    <td class="text-muted">Version IoT:</td>
                                                    <td><strong t-esc="state.iotImage or 'N/A'"/></td>
                                                </tr>
                                            </table>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>

                    <!-- Certification Errors -->
                    <div t-if="hasErrors" class="card mb-2">
                        <div class="card-header bg-warning text-dark py-2">
                            <i class="fa fa-exclamation-triangle me-2"/>
                            Problèmes de conformité
                        </div>
                        <div class="card-body py-2">
                            <p class="fw-bold mb-2">Votre configuration n'est pas conforme à la réglementation LNE :</p>
                            <ul class="mb-2">
                                <li t-foreach="props.errors" t-as="error" t-key="error" t-esc="error"/>
                            </ul>
                        </div>
                    </div>

                    <!-- Server Certification Section -->
                    <div class="card mb-2">
                        <div class="card-header d-flex align-items-center justify-content-between py-2"
                             t-att-class="state.serverCertified ? 'bg-success text-white' : 'bg-danger text-white'">
                            <span>
                                <i class="fa fa-server me-2"/>
                                Certification Serveur
                            </span>
                            <span>
                                <i t-attf-class="fa {{ state.serverCertified ? 'fa-check' : 'fa-times' }}"/>
                            </span>
                        </div>
                        <div class="card-body p-0">
                            <table class="table table-sm table-hover mb-0">
                                <tbody>
                                    <tr>
                                        <td class="text-muted" style="width: 30%;">Global Hash</td>
                                        <td>
                                            <code t-if="state.globalHash"
                                                  class="hash-value small"
                                                  t-att-title="state.globalHash"
                                                  style="cursor: pointer;"
                                                  t-on-click="() => this.copyHash(state.globalHash)">
                                                <t t-esc="state.globalHash"/>
                                                <i class="fa fa-copy ms-1 text-muted"/>
                                            </code>
                                            <span t-else="" class="text-danger">N/A</span>
                                        </td>
                                    </tr>
                                    <tr>
                                        <td class="text-muted">Expected Hash</td>
                                        <td>
                                            <code t-if="state.expectedHash" class="small">
                                                <t t-esc="state.expectedHash"/>
                                            </code>
                                            <span t-else="" class="text-warning">(non défini)</span>
                                        </td>
                                    </tr>
                                    <tr>
                                        <td class="text-muted">Statut</td>
                                        <td>
                                            <span t-if="state.serverCertified" class="badge bg-success">Certifié</span>
                                            <span t-else="" class="badge bg-danger">Non Certifié</span>
                                        </td>
                                    </tr>
                                </tbody>
                            </table>
                        </div>
                    </div>

                    <!-- Footer info -->
                    <div class="text-muted small border-top pt-2 d-flex justify-content-between align-items-center">
                        <span>
                            <i class="fa fa-clock-o me-1"/>
                            Cliquez sur un hash pour le copier
                        </span>
                        <button class="btn btn-sm btn-outline-secondary" t-on-click="copyReport">
                            <i class="fa fa-copy me-1"/>
                            Copier le rapport
                        </button>
                    </div>
                </div>

                <!-- Footer buttons -->
                <div class="d-flex justify-content-end gap-2 p-2 border-top">
                    <a class="btn btn-outline-primary" href="/pos/module_hash/html" target="_blank">
                        <i class="fa fa-external-link me-1"/>
                        Ouvrir page LNE
                    </a>
                    <button class="btn btn-secondary" t-on-click="props.close">
                        Fermer
                    </button>
                </div>
            </div>
        </Dialog>
    </t>

</templates>
